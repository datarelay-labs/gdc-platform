.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.coverage
htmlcov/
*.egg-info/
dist/
build/

*.db
*.db-journal
*.db-shm
*.db-wal
app.db
gdc.db
*.sqlite
*.sqlite3

.env
.env.*
!.env.example
!.env.oss-v1-route-off
!.env.oss-v1-route-on
!scripts/offline/templates/.env.production.template
/logs/
.dev-validation-logs/
tmp/
*.tmp
.cache/
.cursor/*
# Keep Telegram auto-notify hooks trackable for local + cloud agents
!.cursor/hooks.json
!.cursor/hooks/
!.cursor/hooks/**
.cursor/hooks/state/
.DS_Store
*.log
offline-release/
offline-release-*.tar.gz
offline-release-*.tar.gz.sha256

# Node (root + packages; frontend/ also lists node_modules)
node_modules/

# Private keys / certificates / keystores (repo-wide; use fixtures or docs, not real material)
*.key
*.crt
*.pem
*.p12
*.pfx
*.jks
*.csr

# Operator TLS bind-mount (see deploy/docker-compose.https.yml); never commit real keys
deploy/tls/*
!deploy/tls/.gitkeep

# Local TLS defaults (app/config.py GDC_TLS_* paths)
data/tls/

# Database dumps / compressed exports (Alembic stays *.py under alembic/versions/)
*.dump
*.dump.gz
*.sql.gz
dumps/
sql-dumps/

# Generated backups (e.g. scripts/ops/backup-postgres.sh default BACKUP_DIR)
var/backups/
backups/

# Spec-kit / editor safety copies (never commit)
.specify/backup-*/

# Local test run history (smoke/regression junit exports)
.test-history/

# Full E2E Lab Playwright evidence / reports
e2e/reports/
e2e/release-gate/reports/
e2e/test-results/
e2e/playwright-report/

# Cross-Product generated combination streams (large JSONL; summary/baseline committed)
e2e/cross-product/generated/valid-combinations.jsonl
e2e/cross-product/generated/not-applicable.jsonl
e2e/cross-product/generated/shard-plan.json
e2e/cross-product/generated/baseline-candidate-diff.json
e2e/cross-product/diagnostics/
**/cross-product-results.jsonl
*.pid
e2e/reports/.pids/
e2e/reports/.locks/

# Runtime uploads / local artifact sinks
uploads/
local_uploads/
artifacts/

# MinIO on-disk lab mirrors (bucket metadata / local dev bind-mounts)
.minio.sys/
minio-data/

# SFTP fixture home mirrors if copied out of Docker for debugging
sftp-upload/
ssh-scp-upload/

# Support bundle downloads (operational snapshots; keep out of VCS)
support-bundle*.zip

# Release soak artifacts (tracked CSV exports under docs/release/artifacts/)
docs/release/artifacts/*
!docs/release/artifacts/*.csv
