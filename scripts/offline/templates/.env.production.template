# Data Relay (GDC Platform) — offline production environment template
# Copy to configs/.env before install-offline.sh (install script can bootstrap automatically).
# Never commit configs/.env with real secrets.

APP_ENV=production
APP_NAME=Data Relay Platform API
API_PREFIX=/api/v1

POSTGRES_DB=gdc
POSTGRES_USER=gdc
POSTGRES_PASSWORD=change-me-strong-db-password

# Used by host-side tools; API container uses postgres:5432 via compose environment.
DATABASE_URL=postgresql://gdc:change-me-strong-db-password@127.0.0.1:55432/gdc
GDC_PLATFORM_POSTGRES_HOST_PORT=55432

SECRET_KEY=change-me-in-production-use-long-random-string
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_ISSUER=gdc-platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=1440
REQUIRE_AUTH=true
AUTH_DEV_HEADER_TRUST=false
ENCRYPTION_KEY=replace-with-fernet-or-aes-key-placeholder
DEFAULT_COLLECTOR_NAME=datarelay-01

SMTP_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=noreply@example.com
WEBHOOK_TIMEOUT=10

# First install: admin/admin with mandatory password change when unset.
# GDC_SEED_ADMIN_PASSWORD=

# Browser URL printed by install completion banner (recommended for operators).
# GDC_PUBLIC_URL=https://datarelay.example.com:18443/

GDC_HTTP_PORT=18080
GDC_HTTPS_PORT=18443
GDC_PUBLIC_HTTPS_PORT=18443
GDC_API_HOST_PORT=8000
GDC_PROXY_RELOAD_TOKEN=change-me-long-random-token

# Production: dev validation lab must stay off.
ENABLE_DEV_VALIDATION_LAB=false
DEV_VALIDATION_AUTO_START=false

# Optional: generate self-signed TLS during install (GDC_INSTALL_GENERATE_TLS=1).
# GDC_INSTALL_GENERATE_TLS=1
